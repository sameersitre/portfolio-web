# ─── Deploy + seed target ─────────────────────────────────────────────────────
# Copy to `.env.deploy` and fill in. That file is gitignored — THIS REPO IS PUBLIC,
# so never commit real host, user, key path or secret values.
#
# Used by:
#   ./scripts/deploy.sh          build the image and swap the `portfolio` service
#   npm run seed:portfolio       publish lib/content/* through the portfolio API

# ─── VM / SSH ─────────────────────────────────────────────────────────────────
# The box running the compose stack that owns nginx, TLS and the backend.
VM_HOST=203.0.113.10
VM_USER=your-vm-user
# QUOTE any value containing `~`. deploy.sh sources this file, and an UNQUOTED tilde is
# expanded by your LOCAL shell — VM_DIR=~/trovie would become /Users/you/trovie and then be
# sent to the VM as an absolute path that does not exist there. Quoting keeps the `~` literal
# so the REMOTE shell expands it. (deploy.sh also repairs a locally-expanded value, but do not
# rely on that.)
VM_KEY="~/.ssh/your-key"
# Directory on the VM holding docker-compose.yml (the stack this service belongs to).
VM_DIR="~/trovie"

# ─── Site ─────────────────────────────────────────────────────────────────────
# Public hostname, used for the post-deploy 200 check.
DOMAIN=example.com

# ─── Portfolio content API ────────────────────────────────────────────────────
# PUBLIC base URL of the backend serving /api/v2/portfolio/{content,seed}.
# No trailing slash, and NO /api/v2 suffix — the code appends that path itself.
#
# Two distinct uses, both deliberate:
#   1. deploy.sh passes it as the BACKEND_INTERNAL_URL *build arg*, because there is no
#      static fallback: `next build` must reach the live API to prerender `/`. Compose's
#      in-network http://backend:8000 does not resolve inside a build container.
#   2. seed:portfolio targets it when publishing content.
# At RUNTIME the container still gets the fast in-network URL from compose — this value
# is only ever a build-time and tooling input.
API_BASE_URL=https://api.example.com

# ─── Seeding ──────────────────────────────────────────────────────────────────
# The backend's AUTH_SECRET — /portfolio/seed is requireInternalAuth.
# LEAVE THIS EMPTY if the backend runs on the VM above: `npm run seed:portfolio` will
# read the secret straight out of the running backend container over ssh, which avoids
# hand-parsing the VM's .env (a naive `grep | cut -d=` mangles quoted values that
# themselves contain '=', yielding a wrong secret and a confusing 401).
INTERNAL_SECRET=
# Container name to read AUTH_SECRET from when INTERNAL_SECRET is empty.
BACKEND_CONTAINER=trovie-backend-1

# ─── Build-time only ──────────────────────────────────────────────────────────
# Inlined into the client bundle by `next build`, so it must be present at BUILD time.
# Leave empty to ship an image with analytics inert.
NEXT_PUBLIC_GA_ID=

# ─── GitHub (optional but recommended) ────────────────────────────────────────
# Server-only PAT with `read:user`. Passed to `docker build` as a BuildKit SECRET
# (never a build arg — it is a credential and build args land in image history).
# Without it the build prerenders the GitHub section from lib/github/mock.ts, which
# publishes INVENTED stats to every visitor until the first ISR revalidation.
GITHUB_TOKEN=
