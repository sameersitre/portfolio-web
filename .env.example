# ─── Portfolio content backend (optional) ─────────────────────────────────────
# Server-only. Base URL of the trovie backend that serves
# POST /api/v2/portfolio/content. Read at runtime by lib/portfolio.ts.
#   - local dev:  http://localhost:8000
#   - compose:    http://backend:8000  (injected by the `portfolio` service in
#                 trovie/infra/docker-compose.prod.yml — NOT by this repo)
# REQUIRED. There is no static fallback any more: lib/portfolio.ts throws when this is
# unset, when the fetch fails, or when the API returns no content — so `next build` fails
# loudly instead of shipping a blank portfolio. lib/content/* is now only the SEED SOURCE
# (`npm run seed:portfolio`), never a runtime fallback.
BACKEND_INTERNAL_URL=http://localhost:8000

# ─── GitHub (optional) ────────────────────────────────────────────────────────
# Server-only. PAT with `read:user` for the contributions GraphQL query.
# Unset => lib/github/mock.ts data.
GITHUB_TOKEN=

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# Inlined into the client bundle at build time, so it must be present during
# `next build` (Dockerfile passes it via --build-arg NEXT_PUBLIC_GA_ID).
NEXT_PUBLIC_GA_ID=
